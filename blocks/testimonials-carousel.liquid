{% doc %}
  Testimonials carousel
  Horizontal snap carousel of customer cards with a circular photo that
  breaks out of the card top; the photo links to the reviewed product.
{% enddoc %}
{% assign carousel_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .testimonials-carousel-{{ carousel_id }} {
    /* Mobile-first tokens: phone values here, upgraded at 750px / 990px below */
    --section-max-width: 77.5rem;
    --section-padding-x: var(--space-4, 1rem);
    --section-padding-y: var(--space-fluid-lg, clamp(1.5rem, 1rem + 2.5vw, 3rem));
    --card-width: {{ block.settings.card_width }}px;
    --card-gap: clamp(1rem, 0.75rem + 1vw, {{ block.settings.card_gap }}px);
    --card-radius: {{ block.settings.card_border_radius }}px;
    --avatar-size: clamp({{ block.settings.image_size | times: 0.8 | round: 0 }}px, {{ block.settings.image_size | times: 0.8 | round: 0 }}px + 1vw, {{ block.settings.image_size }}px);
    --avatar-ring: {{ block.settings.image_border_width }}px;
    --title-size: clamp(1.75rem, 1.2rem + 1.8vw, {{ block.settings.title_size }}px);
    --name-size: clamp(1rem, 0.9rem + 0.3vw, {{ block.settings.name_size }}px);
    --review-size: clamp(0.9375rem, 0.9rem + 0.2vw, {{ block.settings.review_size }}px);
    --nav-size: var(--touch-target, 44px);
    --surface: {{ block.settings.card_background }};
    --section-bg: {{ block.settings.background_color }};
    --text: {{ block.settings.text_color }};
    --muted: {{ block.settings.review_color }};
    --shadow: {{ block.settings.shadow_color }};
    --nav-bg: {{ block.settings.nav_button_color }};
    --nav-bg-hover: {{ block.settings.nav_button_hover_color }};
    --nav-fg: {{ block.settings.nav_button_icon_color }};

    display: block;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: var(--section-padding-y) var(--section-padding-x);
    background:
      radial-gradient(circle at top, rgba(255,255,255,0.45), transparent 32%),
      var(--section-bg);
    overflow: clip;
  }

  .testimonials-carousel__header-{{ carousel_id }} {
    max-width: min(100%, 45rem);
    margin: 0 auto var(--space-fluid-md, clamp(1rem, 0.75rem + 1.25vw, 2rem));
    text-align: center;
  }

  .testimonials-carousel__title-{{ carousel_id }} {
    margin: 0;
    color: var(--text);
    font-size: var(--title-size);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .testimonials-carousel__wrapper-{{ carousel_id }} {
    position: relative;
    max-width: var(--section-max-width);
    margin: 0 auto;
  }

  .testimonials-carousel__track-{{ carousel_id }} {
    display: grid;
    grid-auto-flow: column;
    /* Phones: one card with a little peek of the next */
    grid-auto-columns: calc(100% - var(--space-8, 2rem));
    gap: var(--card-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: calc(var(--avatar-size) * 0.58) 2px var(--space-3, 0.75rem);
    align-items: stretch;
  }

  .testimonials-carousel__track-{{ carousel_id }}::-webkit-scrollbar {
    display: none;
  }

  .testimonials-carousel__card-{{ carousel_id }} {
    position: relative;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    min-width: 0;
    min-height: 100%;
    padding: calc(var(--avatar-size) * 0.5 + var(--space-5, 1.25rem)) var(--space-5, 1.25rem) var(--space-5, 1.25rem);
    border-radius: min(var(--card-radius), 1.5rem);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.88), rgba(255,255,255,0.96)),
      var(--surface);
    border: 1px solid rgba(17, 24, 39, 0.08);
    box-shadow:
      0 1px 2px rgba(16, 24, 40, 0.04),
      0 1px 30px rgba(16, 24, 40, 0.08),
      0 0 0 1px rgba(255,255,255,0.35) inset;
    transition: transform 180ms ease, box-shadow 180ms ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    isolation: isolate;
  }

  .testimonials-carousel__card-{{ carousel_id }}:hover {
    transform: translateY(-4px);
    box-shadow:
      0 2px 6px rgba(16, 24, 40, 0.06),
      0 18px 40px rgba(16, 24, 40, 0.10),
      0 0 0 1px rgba(255,255,255,0.42) inset;
  }

  .testimonials-carousel__image-link-{{ carousel_id }},
  .testimonials-carousel__image-static-{{ carousel_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 2;
    transform: translate(-50%, -50%);
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 999px;
    overflow: hidden;
    border: var(--avatar-ring) solid var(--surface);
    box-shadow:
      0 8px 18px rgba(16, 24, 40, 0.10),
      0 0 0 1px rgba(17, 24, 39, 0.05);
    background: #f3f4f6;
    display: block;
    flex: 0 0 auto;
  }

  .testimonials-carousel__image-link-{{ carousel_id }} {
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .testimonials-carousel__image-link-{{ carousel_id }}:hover {
    transform: translate(-50%, -50%) scale(1.04);
    box-shadow:
      0 12px 22px rgba(16, 24, 40, 0.14),
      0 0 0 1px rgba(17, 24, 39, 0.06);
  }

  .testimonials-carousel__image-link-{{ carousel_id }}:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 4px;
  }

  .testimonials-carousel__image-{{ carousel_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .testimonials-carousel__image-placeholder-{{ carousel_id }} {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #f9fafb, #eef2f7);
    color: rgba(17, 24, 39, 0.28);
  }

  .testimonials-carousel__image-placeholder-{{ carousel_id }} svg {
    width: 56%;
    height: 56%;
    opacity: 0.42;
  }

  .testimonials-carousel__content-{{ carousel_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }

  .testimonials-carousel__quote-mark-{{ carousel_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    margin: 0 auto var(--space-3, 0.75rem);
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.05);
    color: var(--text);
    font-size: var(--text-lg, 1.125rem);
    line-height: 1;
  }

  .testimonials-carousel__name-{{ carousel_id }} {
    margin: 0 0 var(--space-2, 0.5rem);
    color: var(--text);
    font-size: var(--name-size);
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .testimonials-carousel__review-{{ carousel_id }} {
    margin: 0;
    color: var(--muted);
    font-size: var(--review-size);
    line-height: 1.65;
    overflow: hidden;
    overflow-wrap: anywhere;
    word-break: break-word;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
  }

  .testimonials-carousel__nav-{{ carousel_id }} {
    display: flex;
    justify-content: center;
    gap: var(--space-3, 0.75rem);
    margin-top: var(--space-fluid-md, clamp(1rem, 0.75rem + 1.25vw, 2rem));
  }

  .testimonials-carousel__nav-button-{{ carousel_id }} {
    width: var(--nav-size);
    height: var(--nav-size);
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 999px;
    background: var(--nav-bg);
    color: var(--nav-fg);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 18px rgba(16, 24, 40, 0.08);
    transition: transform 180ms ease, background-color 180ms ease, opacity 180ms ease;
  }

  .testimonials-carousel__nav-button-{{ carousel_id }}:hover {
    background: var(--nav-bg-hover);
    transform: translateY(-1px);
  }

  .testimonials-carousel__nav-button-{{ carousel_id }}:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }

  .testimonials-carousel__nav-button-{{ carousel_id }}:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
  }

  .testimonials-carousel__nav-button-{{ carousel_id }} svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .testimonials-carousel__empty-state-{{ carousel_id }} {
    text-align: center;
    padding: var(--space-fluid-xl, clamp(2rem, 1.25rem + 3.75vw, 4.5rem)) var(--space-5, 1.25rem);
    color: rgba(17, 24, 39, 0.65);
    font-size: var(--text-sm, 0.875rem);
  }

  /* Large phones: cards a bit narrower so two-ish peek */
  @media screen and (min-width: 480px) {
    .testimonials-carousel__track-{{ carousel_id }} {
      grid-auto-columns: minmax(15.625rem, 78vw);
    }
  }

  /* Tablet: fixed card width from settings, larger padding */
  @media screen and (min-width: 750px) {
    .testimonials-carousel-{{ carousel_id }} {
      --section-padding-x: var(--space-5, 1.25rem);
    }

    .testimonials-carousel__track-{{ carousel_id }} {
      grid-auto-columns: minmax(16.25rem, var(--card-width));
    }

    .testimonials-carousel__card-{{ carousel_id }} {
      padding: calc(var(--avatar-size) * 0.5 + var(--space-6, 1.5rem)) var(--space-6, 1.5rem) var(--space-6, 1.5rem);
      border-radius: var(--card-radius);
    }

    .testimonials-carousel__review-{{ carousel_id }} {
      -webkit-line-clamp: 5;
      line-clamp: 5;
    }
  }

  /* Desktop: honour the editor's width percentage */
  @media screen and (min-width: 990px) {
    .testimonials-carousel-{{ carousel_id }} {
      width: min({{ block.settings.desktop_width_percent }}%, 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials-carousel__track-{{ carousel_id }} {
      scroll-behavior: auto;
    }

    .testimonials-carousel__card-{{ carousel_id }},
    .testimonials-carousel__image-link-{{ carousel_id }},
    .testimonials-carousel__nav-button-{{ carousel_id }} {
      transition: none;
    }
  }
{% endstyle %}

<testimonial-carousel-{{ carousel_id }}
  class="testimonials-carousel-{{ carousel_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.title != blank %}
    <div class="testimonials-carousel__header-{{ carousel_id }}">
      <h2 class="testimonials-carousel__title-{{ carousel_id }}">{{ block.settings.title }}</h2>
    </div>
  {% endif %}

  {% assign has_testimonials = false %}
  {% for i in (1..6) %}
    {% liquid
      assign name_key = 'testimonial_' | append: i | append: '_name'
      assign review_key = 'testimonial_' | append: i | append: '_review'
      assign image_key = 'testimonial_' | append: i | append: '_image'
      assign product_key = 'testimonial_' | append: i | append: '_product'

      assign name = block.settings[name_key]
      assign review = block.settings[review_key]
      assign image = block.settings[image_key]
      assign product = block.settings[product_key]

      if name != blank or review != blank
        assign has_testimonials = true
      endif
    %}
  {% endfor %}

  {% if has_testimonials %}
    <div class="testimonials-carousel__wrapper-{{ carousel_id }}">
      <div class="testimonials-carousel__track-{{ carousel_id }}" data-carousel-track>
        {% for i in (1..6) %}
          {% liquid
            assign name_key = 'testimonial_' | append: i | append: '_name'
            assign review_key = 'testimonial_' | append: i | append: '_review'
            assign image_key = 'testimonial_' | append: i | append: '_image'
            assign product_key = 'testimonial_' | append: i | append: '_product'

            assign name = block.settings[name_key]
            assign review = block.settings[review_key]
            assign image = block.settings[image_key]
            assign product = block.settings[product_key]
          %}

          {% if name != blank or review != blank %}
            <article class="testimonials-carousel__card-{{ carousel_id }}">
              {% if product != blank %}
                <a
                  href="{{ product.url }}"
                  class="testimonials-carousel__image-link-{{ carousel_id }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open product page for {{ product.title | escape }}"
                >
                  {% if image %}
                    <img
                      src="{{ image | image_url: width: 320 }}"
                      alt="{{ name | escape }}"
                      class="testimonials-carousel__image-{{ carousel_id }}"
                      loading="lazy"
                      width="320"
                      height="320"
                    >
                  {% else %}
                    <div class="testimonials-carousel__image-placeholder-{{ carousel_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </a>
              {% else %}
                <div class="testimonials-carousel__image-static-{{ carousel_id }}" aria-hidden="true">
                  {% if image %}
                    <img
                      src="{{ image | image_url: width: 320 }}"
                      alt="{{ name | escape }}"
                      class="testimonials-carousel__image-{{ carousel_id }}"
                      loading="lazy"
                      width="320"
                      height="320"
                    >
                  {% else %}
                    <div class="testimonials-carousel__image-placeholder-{{ carousel_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}

              <div class="testimonials-carousel__content-{{ carousel_id }}">
              
                {% if name != blank %}
                  <h3 class="testimonials-carousel__name-{{ carousel_id }}">{{ name }}</h3>
                {% endif %}
                {% if review != blank %}
                  <p class="testimonials-carousel__review-{{ carousel_id }}">{{ review }}</p>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>

      <div class="testimonials-carousel__nav-{{ carousel_id }}">
        <button
          class="testimonials-carousel__nav-button-{{ carousel_id }}"
          data-nav-prev
          aria-label="Previous testimonials"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          class="testimonials-carousel__nav-button-{{ carousel_id }}"
          data-nav-next
          aria-label="Next testimonials"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  {% else %}
    <div class="testimonials-carousel__empty-state-{{ carousel_id }}">
      Add customer testimonials below to show this carousel.
    </div>
  {% endif %}
</testimonial-carousel-{{ carousel_id }}>

<script>
  (function() {
    class TestimonialCarousel{{ carousel_id }} extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-carousel-track]');
        this.prevButton = this.querySelector('[data-nav-prev]');
        this.nextButton = this.querySelector('[data-nav-next]');
        if (!this.track) return;

        this.cards = Array.from(this.track.querySelectorAll('.testimonials-carousel__card-{{ carousel_id }}'));
        this.bindEvents();
        this.updateButtonStates();
      }

      bindEvents() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.scrollByCard(-1));
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.scrollByCard(1));
        }

        this.track.addEventListener('scroll', () => this.updateButtonStates(), { passive: true });
        window.addEventListener('resize', () => this.updateButtonStates(), { passive: true });
      }

      getScrollAmount() {
        const firstCard = this.cards[0];
        if (!firstCard) return this.track.clientWidth * 0.85;

        const cardStyles = window.getComputedStyle(this.track);
        const gap = parseFloat(cardStyles.columnGap || cardStyles.gap || 0);
        return firstCard.getBoundingClientRect().width + gap;
      }

      scrollByCard(direction) {
        this.track.scrollBy({
          left: this.getScrollAmount() * direction,
          behavior: 'smooth'
        });
      }

      updateButtonStates() {
        if (!this.prevButton || !this.nextButton) return;

        const maxScrollLeft = this.track.scrollWidth - this.track.clientWidth;
        const isAtStart = this.track.scrollLeft <= 4;
        const isAtEnd = this.track.scrollLeft >= maxScrollLeft - 4;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd || maxScrollLeft <= 0;
      }
    }

    if (!customElements.get('testimonial-carousel-{{ carousel_id }}')) {
      customElements.define('testimonial-carousel-{{ carousel_id }}', TestimonialCarousel{{ carousel_id }});
    }
  })();
</script>


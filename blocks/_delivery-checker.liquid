<div class="askus-delivery-checker">
  <h4>📍 Check Delivery Availability</h4>

  <div class="askus-pincode-wrapper">
    <input
      type="text"
      id="askus-pincode"
      maxlength="6"
      placeholder="Enter 6-digit Pincode"
    >
    <button type="button" onclick="askusCheckPincode()">
      Check
    </button>
  </div>

  <div id="askus-delivery-result"></div>
</div>

<style>
.askus-delivery-checker{
  margin-top:15px;
  padding:15px;
  border:1px solid rgba(0,0,0,.08);
  border-radius:12px;
  background:#fff;
}

.askus-delivery-checker h4{
  margin:0 0 12px;
  font-size:16px;
}

.askus-pincode-wrapper{
  display:flex;
  gap:10px;
}

.askus-pincode-wrapper input{
  flex:1;
  min-height:46px;
  padding:0 15px;
  border:1px solid #ddd;
  border-radius:8px;
  outline:none;
}

.askus-pincode-wrapper button{
  min-width:120px;
  border:none;
  border-radius:8px;
  cursor:pointer;
  font-weight:600;
  padding:0 18px;
  background:#000;
  color:#fff;
}

#askus-delivery-result{
  margin-top:12px;
  font-size:14px;
  line-height:1.6;
}

.askus-success{
  color:#0f8a3d;
}

.askus-error{
  color:#d93025;
}

@media(max-width:749px){
  .askus-pincode-wrapper{
    flex-direction:column;
  }

  .askus-pincode-wrapper button{
    width:100%;
    min-height:46px;
  }
}
</style>

<script>
async function askusCheckPincode() {

  const pincode = document.getElementById('askus-pincode').value.trim();
  const result = document.getElementById('askus-delivery-result');

  if(!/^[1-9][0-9]{5}$/.test(pincode)){
    result.innerHTML =
      '<div class="askus-error">❌ Please enter a valid Indian pincode.</div>';
    return;
  }

  result.innerHTML = 'Checking delivery availability...';

  try {

    const response = await fetch(
      'https://api.postalpincode.in/pincode/' + pincode
    );

    const data = await response.json();

    if(
      data[0].Status === 'Success' &&
      data[0].PostOffice &&
      data[0].PostOffice.length
    ){

      const office = data[0].PostOffice[0];

      result.innerHTML = `
        <div class="askus-success">
          ✅ Delivery Available<br>
          📍 ${office.District}, ${office.State}<br>
          🚚 Estimated Delivery: 3–7 Business Days<br>
          💳 Cash on Delivery Available
        </div>
      `;

    } else {

      result.innerHTML =
      '<div class="askus-error">❌ Delivery unavailable for this pincode.</div>';
    }

  } catch(err){

    result.innerHTML =
      '<div class="askus-error">❌ Unable to verify pincode. Please try again.</div>';
  }
}
</script>
{% schema %}
{
  "name": "Delivery Checker",
  "settings": [],
  "presets": [
    {
      "name": "Delivery Checker"
    }
  ]
}
{% endschema %}
<div class="askus-delivery-checker">
  <h4>📍 Check Delivery Availability</h4>

  <div class="askus-pincode-wrapper">
    <input
      type="text"
      id="askus-pincode"
      maxlength="6"
      placeholder="Enter 6-digit Pincode"
    >
    <button type="button" onclick="askusCheckPincode()">
      Check
    </button>
  </div>

  <div id="askus-delivery-result"></div>
</div>

<style>
/* Mobile-first: stacked input + button; inline row from 480px */
.askus-delivery-checker{
  margin-top:var(--space-4, 1rem);
  padding:var(--space-4, 1rem);
  border:1px solid rgba(0,0,0,.08);
  border-radius:var(--space-3, 0.75rem);
  background:#fff;
}

.askus-delivery-checker h4{
  margin:0 0 var(--space-3, 0.75rem);
  font-size:var(--text-base, 1rem);
}

.askus-pincode-wrapper{
  display:flex;
  flex-direction:column;
  gap:var(--space-2, 0.5rem);
}

.askus-pincode-wrapper input{
  flex:1 1 auto;
  min-width:0;
  min-height:var(--touch-target, 44px);
  padding:0 var(--space-4, 1rem);
  font-size:max(1rem, var(--text-base, 1rem)); /* ≥16px: no iOS zoom */
  border:1px solid #ddd;
  border-radius:var(--space-2, 0.5rem);
  outline:none;
}

.askus-pincode-wrapper button{
  width:100%;
  min-height:var(--touch-target, 44px);
  border:none;
  border-radius:var(--space-2, 0.5rem);
  cursor:pointer;
  font-weight:600;
  font-size:var(--text-sm, 0.875rem);
  padding:0 var(--space-5, 1.25rem);
  background:#000;
  color:#fff;
}

.askus-pincode-wrapper button:focus-visible,
.askus-pincode-wrapper input:focus-visible{
  outline:2px solid currentcolor;
  outline-offset:2px;
}

#askus-delivery-result{
  margin-top:var(--space-3, 0.75rem);
  font-size:var(--text-sm, 0.875rem);
  line-height:1.6;
}

.askus-success{ color:#0f8a3d; }
.askus-error{ color:#d93025; }

@media screen and (min-width: 480px){
  .askus-pincode-wrapper{
    flex-direction:row;
  }
  .askus-pincode-wrapper button{
    width:auto;
    flex:0 0 auto;
    min-width:7.5rem;
  }
}
</style>

<script>
async function askusCheckPincode() {

  const pincode = document.getElementById('askus-pincode').value.trim();
  const result = document.getElementById('askus-delivery-result');

  if(!/^[1-9][0-9]{5}$/.test(pincode)){
    result.innerHTML =
      '<div class="askus-error">❌ Please enter a valid Indian pincode.</div>';
    return;
  }

  result.innerHTML = 'Checking delivery availability...';

  try {

    const response = await fetch(
      'https://api.postalpincode.in/pincode/' + pincode
    );

    const data = await response.json();

    if(
      data[0].Status === 'Success' &&
      data[0].PostOffice &&
      data[0].PostOffice.length
    ){

      const office = data[0].PostOffice[0];

      result.innerHTML = `
        <div class="askus-success">
          ✅ Delivery Available<br>
          📍 ${office.District}, ${office.State}<br>
          🚚 Estimated Delivery: 3–7 Business Days<br>
          💳 Cash on Delivery Available
        </div>
      `;

    } else {

      result.innerHTML =
      '<div class="askus-error">❌ Delivery unavailable for this pincode.</div>';
    }

  } catch(err){

    result.innerHTML =
      '<div class="askus-error">❌ Unable to verify pincode. Please try again.</div>';
  }
}
</script>
{% schema %}
{
  "name": "Delivery Checker",
  "settings": [],
  "presets": [
    {
      "name": "Delivery Checker"
    }
  ]
}
{% endschema %}
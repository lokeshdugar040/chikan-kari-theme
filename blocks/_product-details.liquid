{%- assign block_settings = block.settings -%}
<div
  id="ProductInformation-{{ section.id }}"
  class="
    product-details
    {% if block_settings.sticky_details_desktop %} sticky-content--desktop{% endif %}
    {% if block_settings.height == 'fill' -%} full-height--desktop{% endif -%}
  "
  style="--details-position: {{ block_settings.details_position }};"
  data-testid="product-information-details"
  {% if settings.transition_to_main_product %}
    data-view-transition-type="product-details"
  {% endif %}
>
  {% capture children %}
    <div class="view-product-title">
      <a
        href="{{ closest.product.selected_or_first_available_variant.url }}"
        class="link"
      >
        {{- closest.product.title }}
      </a>
    </div>

    {% assign current_variant = closest.product.selected_or_first_available_variant %}

    <div class="variant-info-wrapper">
      <div id="variant-info-box-{{ section.id }}">
        {% if current_variant.metafields.custom.variant_display_name.value != blank %}
          <p id="variant-display-name-{{ section.id }}">{{ current_variant.metafields.custom.variant_display_name.value }}</p>
        {% endif %}

        {% if current_variant.metafields.custom.variant_short_title.value != blank %}
          <p id="variant-short-title-{{ section.id }}">{{ current_variant.metafields.custom.variant_short_title.value }}</p>
        {% endif %}

        {% if current_variant.metafields.custom.variant_subtitle.value != blank %}
          <p id="variant-subtitle-{{ section.id }}">{{ current_variant.metafields.custom.variant_subtitle.value }}</p>
        {% endif %}

        {% if current_variant.metafields.custom.variant_description.value != blank %}
          <div id="variant-description-{{ section.id }}">
            {{ current_variant.metafields.custom.variant_description | metafield_tag }}
          </div>
        {% endif %}
      </div>
    </div>

    {% content_for 'blocks' %}

    <div id="premium-usp-band-mount-{{ section.id }}" class="premium-usp-band-mount" hidden>
      {% render 'premium-usp-band' %}
    </div>
  {% endcapture %}

  {% render 'group', children: children, settings: block_settings, shopify_attributes: block.shopify_attributes %}
</div>

<script>
  (function() {
    var sectionId = '{{ section.id }}';

    function moveUspBand() {
      var scope = document.getElementById('ProductInformation-' + sectionId);
      if (!scope) return false;

      var mount = document.getElementById('premium-usp-band-mount-' + sectionId);
      if (!mount) return false;

      var buyNowButton = scope.querySelector('shopify-buy-it-now-button');
      if (!buyNowButton) return false;

      if (mount.previousElementSibling === buyNowButton) {
        mount.hidden = false;
        return true;
      }

      buyNowButton.insertAdjacentElement('afterend', mount);
      mount.hidden = false;
      return true;
    }

    function initUspBandMove() {
      if (moveUspBand()) return;

      var scope = document.getElementById('ProductInformation-' + sectionId);
      if (!scope) return;

      var observer = new MutationObserver(function() {
        if (moveUspBand()) {
          observer.disconnect();
        }
      });

      observer.observe(scope, { childList: true, subtree: true });

      setTimeout(function() {
        observer.disconnect();
        moveUspBand();
      }, 5000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initUspBandMove);
    } else {
      initUspBandMove();
    }
  })();
</script>

{% stylesheet %}
  @media screen and (max-width: 749px) {
    .product-information.section--page-width .product-details > .group-block {
      padding-inline: 0;
    }
  }

  .view-product-title {
    display: none;
  }

  .product-details {
    display: flex;
    align-self: start;
    justify-content: flex-start;
  }

  .variant-info-wrapper {
    width: 100%;
  }

  /* The stylesheet tag in a theme block is extracted into one shared, static
     asset: Liquid is not interpolated per instance, so the section-id based
     selectors that used to live here only ever matched the first product-details
     block on the page. These rules are now scoped with :scope plus an id-prefix
     match, so every instance styles itself while the section-id suffixes that
     assets/variant-picker.js queries stay intact in the markup. */
  :scope [id^="variant-info-box"] {
    margin-top: 8px;
    width: 100%;
  }

  :scope [id^="variant-display-name"] {
    margin: 6px 0 0 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  :scope [id^="variant-short-title"] {
    margin: 4px 0 0 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }

  :scope [id^="variant-subtitle"] {
    margin: 4px 0 0 0;
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.8;
  }

  :scope [id^="variant-description"] {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.6;
  }

  :scope [id^="variant-description"] p {
    margin: 0 0 10px 0;
  }

  :scope [id^="variant-description"] p:last-child {
    margin-bottom: 0;
  }

  .premium-usp-band-mount[hidden] {
    display: none !important;
  }

  .premium-usp-band-mount {
    width: 100%;
    margin-top: 10px;
  }

  /* Hide old generated coupon block permanently */
  [class*="coupon-body-template--"] {
    display: none !important;
  }

  @media screen and (min-width: 750px) {
    .product-details > .group-block {
      height: min-content;
    }

    .full-height--desktop {
      height: 100%;
      max-height: calc(100vh - var(--header-group-height, 0));
      min-height: fit-content;
    }

    .full-height--desktop .group-block {
      align-self: var(--details-position, 'flex-start');
    }
  }
{% endstylesheet %}


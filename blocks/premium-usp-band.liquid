        { "value": "1.5rem", "label": "24px" }
      ],
      "default": "1.125rem"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FCF8F3"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title colour",

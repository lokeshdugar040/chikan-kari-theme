{%- doc -%}
  Renders product-card variant swatches.

  Shows a maximum of three swatches and then displays the
  remaining variant count as +2, +3, +4, etc.

  @param {object} product_resource - The product object.
  @param {boolean} [has_option_selected] - Whether to preselect a swatch.
{%- enddoc -%}

{% liquid
  assign allow_preselection = false

  if product_resource.selected_variant or has_option_selected
    assign allow_preselection = true
  endif
%}

<swatches-variant-picker-component
  data-product-id="{{ product_resource.id }}"
  data-product-url="{{ product_resource.url }}"
  ref="swatchesVariantPicker"
>
  <form>
    {%- for product_option in product_resource.options_with_values -%}

      {% liquid
        assign swatch_count = product_option.values | map: 'swatch' | compact | size
      %}

      {% if swatch_count == 0 %}
        {% continue %}
      {% endif %}

      {% liquid
        assign total_swatch_count = product_option.values.size
        assign visible_swatch_count = 3
        assign hidden_swatch_count = total_swatch_count | minus: visible_swatch_count

        if hidden_swatch_count < 0
          assign hidden_swatch_count = 0
        endif

        assign swatch_option_position = product_option.position
        assign swatch_option_key = 'option' | append: swatch_option_position
      %}

      <fieldset
        class="variant-option variant-option--buttons variant-option--swatches"
        data-swatch-count="{{ total_swatch_count }}"
      >
        <ul class="variant-option__swatches-list">

          {%- for product_option_value in product_option.values limit: visible_swatch_count -%}

            {% liquid
              assign featured_media = product_option_value.variant.featured_media
              assign first_available_variant = blank

              if featured_media == blank
                if product_option_value.variant == blank
                  for variant in product_resource.variants
                    if variant.available and variant[swatch_option_key] == product_option_value.name and variant.featured_media
                      assign featured_media = variant.featured_media
                      assign first_available_variant = variant
                      break
                    endif
                  endfor
                elsif product_option_value.product_url
                  assign featured_media = product_option_value.variant.product.featured_media
                endif
              endif
            %}

            <li class="variant-option__swatch">
              <label
                data-media-id="{{ featured_media.id }}"
                class="variant-option__button-label variant-option__button-label--has-swatch"
                on:pointerenter="product-card/previewVariant/{{ featured_media.id }}"
                on:pointerleave="product-card/resetVariant"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ product_resource.id }}-swatch"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-media-id="{{ featured_media.id }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if allow_preselection and product_option_value.selected %}
                    checked
                  {% endif %}
                  data-variant-id="{{ first_available_variant.id | default: product_option_value.variant.id }}"
                  data-first-available-or-first-variant-id="{{ first_available_variant.id | default: product_option_value.variant.id }}"
                >

                {% render 'swatch',
                  swatch: product_option_value.swatch,
                  variant_image: featured_media,
                  mode: 'unscaled'
                %}

                {% render 'strikethrough-variant',
                  product_option: product_option_value
                %}
              </label>
            </li>
          {%- endfor -%}

          {% if hidden_swatch_count > 0 %}
            <li
              class="product-card-swatch-more"
              aria-label="{{ hidden_swatch_count }} more variants"
            >
              <span aria-hidden="true">
                +{{ hidden_swatch_count }}
              </span>
            </li>
          {% endif %}

        </ul>
      </fieldset>
    {%- endfor -%}

    <script type="application/json">
      {{ product_resource.selected_or_first_available_variant | json }}
    </script>
  </form>
</swatches-variant-picker-component>

{% stylesheet %}

/* ============================================================
   PRODUCT CARD SWATCHES
   Maximum 3 swatches +N
   4:5 portrait images
   ============================================================ */

swatches-variant-picker-component {
  display: flex;
  width: 100%;
  flex-direction: row;
  justify-content: var(--product-swatches-alignment-mobile);

  overflow: visible !important;
}

@media screen and (min-width: 750px) {
  swatches-variant-picker-component {
    justify-content: var(--product-swatches-alignment);
  }
}


/* Swatch list */
product-swatches .variant-option__swatches-list,
swatches-variant-picker-component .variant-option__swatches-list {
  display: flex !important;
  flex-wrap: nowrap !important;
  align-items: center;

  width: max-content;
  max-width: 100%;

  gap: 8px;

  padding: 0 !important;
  margin: 0 !important;

  list-style: none;
  overflow: visible !important;
}


/* Variant swatch item */
swatches-variant-picker-component .variant-option__swatch {
  display: block !important;
  flex: 0 0 34px !important;

  width: 34px !important;
  min-width: 34px !important;

  height: 42.5px !important;
  min-height: 42.5px !important;

  padding: 0 !important;
  margin: 0 !important;
}


/* Clickable label */
swatches-variant-picker-component
.variant-option__button-label--has-swatch {
  position: relative;

  display: inline-flex !important;
  align-items: center;
  justify-content: center;

  width: 34px !important;
  min-width: 34px !important;

  height: 42.5px !important;
  min-height: 42.5px !important;

  padding: 0 !important;
  margin: 0 !important;

  aspect-ratio: 4 / 5 !important;

  background: transparent !important;
  border: 0 !important;
  border-radius: 6px !important;
  box-shadow: none !important;

  overflow: hidden !important;
}


/* Actual swatch image */
swatches-variant-picker-component .swatch,
swatches-variant-picker-component .swatch--unscaled,
swatches-variant-picker-component .swatch--variant-image,
swatches-variant-picker-component .swatch--image {
  display: block !important;

  width: 34px !important;
  min-width: 34px !important;

  height: 42.5px !important;
  min-height: 42.5px !important;

  aspect-ratio: 4 / 5 !important;

  box-sizing: border-box;

  border-radius: 6px !important;
  overflow: hidden !important;

  background-repeat: no-repeat !important;
  background-size: cover !important;
  background-position: top center !important;
}


/* Keep the radio input clickable */
swatches-variant-picker-component
.variant-option__button-label--has-swatch
input {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  margin: 0;
  padding: 0;

  cursor: pointer;
}


/* Remove circular pseudo-elements */
swatches-variant-picker-component
.variant-option__button-label--has-swatch::before,
swatches-variant-picker-component
.variant-option__button-label--has-swatch::after,
swatches-variant-picker-component .swatch::before,
swatches-variant-picker-component .swatch::after {
  display: none !important;
  content: none !important;
}


/* +N counter */
swatches-variant-picker-component .product-card-swatch-more {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;

  flex: 0 0 34px !important;

  width: 34px !important;
  min-width: 34px !important;

  height: 42.5px !important;
  min-height: 42.5px !important;

  padding: 0 !important;
  margin: 0 !important;

  color: currentColor;
  background: transparent;

  font-size: 11px;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}


/* Selected swatch */
swatches-variant-picker-component
.variant-option__button-label--has-swatch:has(input:checked) {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}


/* Desktop */
@media screen and (min-width: 750px) {
  swatches-variant-picker-component
  .variant-option__swatch {
    flex-basis: 36px !important;

    width: 36px !important;
    min-width: 36px !important;

    height: 45px !important;
    min-height: 45px !important;
  }

  swatches-variant-picker-component
  .variant-option__button-label--has-swatch {
    width: 36px !important;
    min-width: 36px !important;

    height: 45px !important;
    min-height: 45px !important;
  }

  swatches-variant-picker-component .swatch,
  swatches-variant-picker-component .swatch--unscaled,
  swatches-variant-picker-component .swatch--variant-image,
  swatches-variant-picker-component .swatch--image {
    width: 36px !important;
    min-width: 36px !important;

    height: 45px !important;
    min-height: 45px !important;
  }

  swatches-variant-picker-component
  .product-card-swatch-more {
    flex-basis: 36px !important;

    width: 36px !important;
    min-width: 36px !important;

    height: 45px !important;
    min-height: 45px !important;
  }
}


/* Mobile */
@media screen and (max-width: 749px) {
  swatches-variant-picker-component
  .variant-option__swatch {
    flex-basis: 32px !important;

    width: 32px !important;
    min-width: 32px !important;

    height: 40px !important;
    min-height: 40px !important;
  }

  swatches-variant-picker-component
  .variant-option__button-label--has-swatch {
    width: 32px !important;
    min-width: 32px !important;

    height: 40px !important;
    min-height: 40px !important;
  }

  swatches-variant-picker-component .swatch,
  swatches-variant-picker-component .swatch--unscaled,
  swatches-variant-picker-component .swatch--variant-image,
  swatches-variant-picker-component .swatch--image {
    width: 32px !important;
    min-width: 32px !important;

    height: 40px !important;
    min-height: 40px !important;
  }

  swatches-variant-picker-component
  .product-card-swatch-more {
    flex-basis: 32px !important;

    width: 32px !important;
    min-width: 32px !important;

    height: 40px !important;
    min-height: 40px !important;
  }
}

{% endstylesheet %}
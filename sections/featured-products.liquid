{%- style -%}
.featured-products{padding:var(--space-2xl) 0;background:var(--color-bg-secondary)}.featured-products__container{max-width:var(--container-max);margin:0 auto;padding:0 var(--gutter)}.featured-products__heading{text-align:center;font-size:var(--text-2xl);margin-bottom:var(--space-md)}.featured-products__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-lg)}.product-card{display:block}.product-card__image{aspect-ratio:4/5;background:var(--color-border);border-radius:var(--card-radius);overflow:hidden;margin-bottom:var(--space-sm)}.product-card__image img{width:100%;height:100%;object-fit:cover}.product-card__title{font-size:var(--text-sm);font-weight:500;margin-bottom:4px}.product-card__price{font-size:var(--text-sm);color:var(--color-text-muted)}@media(max-width: 1024px){.featured-products__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width: 768px){.featured-products__grid{grid-template-columns:repeat(2,1fr);gap:var(--space-md)}.featured-products{padding:var(--space-xl) 0}}
{%- endstyle -%}
<section class="featured-products"><div class="featured-products__container"><h2 class="featured-products__heading">{{section.settings.heading}}</h2><div class="featured-products__grid">{%-for product in section.settings.collection.products limit: section.settings.products_to_show-%}<a href="{{product.url}}"class="product-card"><div class="product-card__image"><img src="{{product.featured_media|image_url:width:400}}"alt="{{product.title}}"loading="lazy"width="400"height="500"></div><div class="product-card__title">{{product.title}}</div><div class="product-card__price">{{product.price|money}}</div></a>{%-endfor-%}</div></div></section>
{% schema %}{"name":"Featured Products","settings":[{"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"products_to_show","label":"Products","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Featured Products"}]}{% endschema %}

{%- style -%}
.collection-list{padding:var(--space-2xl) 0}.collection-list__container{max-width:var(--container-max);margin:0 auto;padding:0 var(--gutter)}.collection-list__heading{text-align:center;font-size:var(--text-2xl);margin-bottom:var(--space-md)}.collection-list__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-lg)}.collection-list__item{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:var(--card-radius)}.collection-list__item img{width:100%;height:100%;object-fit:cover;transition:transform var(--duration-slow)}.collection-list__item:hover img{transform:scale(1.05)}.collection-list__overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.6),transparent);display:flex;align-items:flex-end;padding:var(--space-md)}.collection-list__title{color:#FFF;font-size:var(--text-lg);font-weight:500}.collection-list__subtitle{color:rgba(255,255,255,0.9);font-size:var(--text-sm);margin-top:4px}@media(max-width: 1024px){.collection-list__grid{grid-template-columns:repeat(2,1fr)}}@media(max-width: 768px){.collection-list__grid{grid-template-columns:1fr}.collection-list{padding:var(--space-xl) 0}}
{%- endstyle -%}
<section class="collection-list"><div class="collection-list__container"><h2 class="collection-list__heading">{{section.settings.heading}}</h2><div class="collection-list__grid">{%-for block in section.blocks-%}<a href="{{block.settings.collection.url}}"class="collection-list__item"><img src="{{block.settings.collection.image|image_url:width:600}}"alt="{{block.settings.collection.title}}"loading="lazy"width="600"height="750"><div class="collection-list__overlay"><div><div class="collection-list__title">{{block.settings.collection.title}}</div>{%-if block.settings.subtitle != blank-%}<div class="collection-list__subtitle">{{block.settings.subtitle}}</div>{%-endif-%}</div></div></a>{%-endfor-%}</div></div></section>
{% schema %}{"name":"Collection List","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop by Category"}],"blocks":[{"type":"collection","name":"Collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"subtitle","label":"Subtitle"}]}],"presets":[{"name":"Collection List","blocks":[{"type":"collection"},{"type":"collection"},{"type":"collection"},{"type":"collection"}]}]}{% endschema %}

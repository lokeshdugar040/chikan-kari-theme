{%- style -%}
.newsletter{padding:var(--space-2xl) 0;background:var(--color-primary);color:#FFF}.newsletter__container{max-width:var(--container-narrow);margin:0 auto;padding:0 var(--gutter);text-align:center}.newsletter__heading{font-size:var(--text-2xl);margin-bottom:var(--space-sm)}.newsletter__subheading{font-size:var(--text-base);opacity:0.9;margin-bottom:var(--space-lg)}.newsletter__form{display:flex;gap:var(--space-sm);max-width:500px;margin:0 auto}.newsletter__input{flex:1;height:var(--input-height);padding:var(--input-padding);border:1px solid rgba(255,255,255,0.3);border-radius:var(--btn-radius);background:rgba(255,255,255,0.1);color:#FFF;font-size:var(--text-base)}.newsletter__input::placeholder{color:rgba(255,255,255,0.6)}.newsletter__button{height:var(--btn-height);padding:var(--btn-padding);background:#FFF;color:var(--color-primary);border:none;border-radius:var(--btn-radius);font-weight:600;cursor:pointer;white-space:nowrap}@media(max-width: 768px){.newsletter__form{flex-direction:column}.newsletter__button{width:100%}}
{%- endstyle -%}
<section class="newsletter"><div class="newsletter__container"><h2 class="newsletter__heading">{{section.settings.heading}}</h2><p class="newsletter__subheading">{{section.settings.subheading}}</p>{%-form 'customer',class:'newsletter__form'-%}<input type="hidden"name="contact[tags]"value="newsletter"><input type="email"name="contact[email]"class="newsletter__input"placeholder="your@email.com"required><button type="submit"class="newsletter__button">{{section.settings.button_text}}</button>{%-endform-%}</div></section>
{% schema %}{"name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Join Our Community"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Get 10% off your first order + exclusive access to new collections."},{"type":"text","id":"button_text","label":"Button Text","default":"Subscribe"}],"presets":[{"name":"Newsletter"}]}{% endschema %}

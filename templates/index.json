    "1772474882e1e16933": {
      "type": "_blocks",
      "blocks": {
        "testimonials_carousel_EyBkYd": {
          "type": "testimonials-carousel",
          "settings": {
            "title": "What our customers say",
            "desktop_width_percent": 100,
            "background_color": "#f8f4ed",
            "text_color": "#6e5841",
            "title_size": 20,
            "name_size": 18,
            "review_size": 14,
            "review_color": "#3d3028",
            "card_width": 240,
            "card_gap": 28,
            "card_background": "#fffdf9",
            "card_border_radius": 12,
            "shadow_color": "#00000014",
            "image_size": 104,
            "image_border_width": 2,
            "nav_button_color": "#6e5841",
            "nav_button_hover_color": "#d9b58e",
            "nav_button_icon_color": "#ffffff",
            "testimonial_1_name": "Pooja Malhotra",
            "testimonial_1_review": "I’ve been searching for a white viscose mukaish kurti for so long, but everything I found either was too expensive or had poor quality. Finally, I found this one, and I couldn’t be happier! The quality is amazing, and it’s exactly what I was looking for—elegant yet affordable. Definitely worth the purchase!",
            "testimonial_1_image": "shopify://shop_images/WhatsApp_Image_2026-02-23_at_17.18.14_82c4b0a2-499f-4ce9-8ef3-6935cad79264.jpg",
            "testimonial_1_product": "white-mukaish-viscose-kurti-with-mukaish-resham-thread-jaal-work",
            "testimonial_2_name": "Shobhita Mishra",
            "testimonial_2_review": "I have been buying from them for quite some time now, and it’s always been a lovely experience. I often pick pieces for my mother and sister, and they genuinely love them. The quality and designs are consistently beautiful. Truly loved it!",
            "testimonial_2_image": "shopify://shop_images/Untitled-4ssyutdyu_d496aab4-db2f-4022-b992-66fab6384575.png",
            "testimonial_2_product": "noor-e-kota-chikankari-kurta-1",
            "testimonial_3_name": "Lwy Aparana Kapoor",
            "testimonial_3_review": "One of the few places where quality and pricing stay consistent over time. I’ve been shopping from Chikankari Exclusive since day one, and it’s always been worth it.",
            "testimonial_3_image": "shopify://shop_images/Blue_Kurti_new_3bae8bd1-bdae-4ffb-ad8b-84891c855d81.png",
            "testimonial_3_product": "maroon-viscose-kurti-with-resham-thread-jaal-work",
            "testimonial_4_name": "Sangita Dudani",
            "testimonial_4_review": "I’ve been a customer since they started, and that itself says a lot. Beautiful chikankari, reliable quality, and honest pricing — always a great experience.",
            "testimonial_4_image": "shopify://shop_images/Mal_kurti_new_collection_69089dc2-7b4e-4e9b-a1dd-9bc9bf43eba0.png",
            "testimonial_4_product": "mal-chanderi-dupatta-set-embroidery-cutdana-work-copy",
            "testimonial_5_name": "Nandita Mishra",
            "testimonial_5_review": "Beautiful traditional work with modern styling. Absolutely love my purchase!",
            "testimonial_5_image": "shopify://shop_images/f94fd22d-fbde-48df-a5e0-2a103c74a416_d30eecc6-cc29-4b6e-af07-a20b9e1eba86.jpg",
            "testimonial_5_product": "noor-e-zaitoon-modal-kurta-1",
            "testimonial_6_name": "Renuka",
            "testimonial_6_review": "I’ve been shopping here for quite a while now, and I honestly couldn’t be more satisfied! The products are always of amazing quality, and I feel like I’m getting the best value for my money every time. It’s so rare to find a brand that truly delivers both quality and affordability, and that’s why I keep coming back. I always know I can trust them to provide exactly what I’m looking for every time.",
            "testimonial_6_image": "shopify://shop_images/Happy_after_receiving_order_1ad67446-c2c0-439e-894f-adc116aa316e.png",
            "testimonial_6_product": "white-pastel-blue-mal-chanderi-dress-material"
          },
          "blocks": {}
        }
